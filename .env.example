# 微信公众号测试号配置
# 微信测试号的 Token（自己随便设一个，要和微信后台填的一样）
WECHAT_TOKEN=huize_wechat_2026

# 微信测试号的 appID 和 appsecret（在测试号后台能看到）
WECHAT_APPID=你的appid
WECHAT_SECRET=你的appsecret

# DeepSeek API 配置
DEEPSEEK_API_KEY=你的DeepSeek_API_Key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# GPT-SoVITS 配置
SOVITS_API_URL=http://127.0.0.1:9880
REFERENCE_AUDIO_PATH=你的参考音频路径/ref.WAV
REFERENCE_TEXT=参考音频的文字内容

# TTS 参数
TTS_TEXT_LANG=zh
TTS_REF_LANG=zh
TTS_SPEED=1.0
TTS_TOP_K=5
TTS_TOP_P=0.85
TTS_TEMPERATURE=0.8

# ffmpeg 路径（GPT-SoVITS 一般自带）
FFMPEG_PATH=你的路径/runtime/ffmpeg.exe

# 语音回复概率（0-1，越大越常发语音）
VOICE_REPLY_PROBABILITY=0.6

# Flask 服务端口
FLASK_PORT=5000
